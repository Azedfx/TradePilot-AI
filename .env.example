# Server
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://tradepilot:tradepilot@localhost:5432/tradepilot?schema=public"

# LLM provider: "placeholder" runs without keys; set QWEN_API_KEY to use Qwen
# Qwen runs through the Bitget hackathon proxy (OpenAI-compatible chat/completions)
LLM_PROVIDER=placeholder
QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max

# Market data provider: "bitget" (default) uses public Bitget Reality + datahub MCP
MARKET_DATA_PROVIDER=bitget

# Dual MCP (handbook Track 3 — both required):
# - bitget-signal: crypto macro / sentiment / news / TA (+ tradfi bridge)
# - bitget-mcp-server: US stock / ETF quotes & fundamentals (preferred for fundamentals)
MCP_URL=https://datahub.noxiaohao.com/mcp
BITGET_US_MCP_URL=https://agent.bitget.com/mcp

# Optional: Finnhub for earnings expectation gaps (fundamentals skill)
FINNHUB_API_KEY=
