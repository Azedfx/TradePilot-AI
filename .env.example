# Server
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://tradepilot:tradepilot@localhost:5432/tradepilot?schema=public"

# LLM provider: "placeholder" runs without keys; swap to a real provider later
LLM_PROVIDER=placeholder

# Market data provider: "bitget" (default) uses public Bitget + datahub MCP
MARKET_DATA_PROVIDER=bitget

# Bitget market-data MCP server (Agent Hub distributed research skills)
MCP_URL=https://datahub.noxiaohao.com/mcp
